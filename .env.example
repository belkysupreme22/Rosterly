# =============================================================================
# Rosterly — Environment Configuration
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Values in `.env.local` take precedence over `.env` and are git-ignored.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Default matches docker-compose.yml configuration (port 5555 mapped to 5432).
DATABASE_URL="postgres://postgres:postgrespassword@localhost:5555/rosterly"

# ── Better Auth Configuration ───────────────────────────────────────────────
# Secret key used for session signing and token encryption (min 32 characters).
# Generate a new random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="rosterly-secret-32-chars-long-auth-token-dev"

# Canonical URL for the Better Auth backend.
# In local development: http://localhost:5173
# In production: https://your-production-domain.com
BETTER_AUTH_URL="http://localhost:5173"

# Public-facing application URL (used in email links, document verification QR codes).
PUBLIC_APP_URL="http://localhost:5173"

# Comma-separated list of additional allowed CORS / Trusted Origins (optional).
# Defaults include localhost:5173, localhost:3000, 127.0.0.1:5173.
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Telegram Bot (Layer 3 Self-Service) ──────────────────────────────────────
# Telegram Bot Token from @BotFather on Telegram (optional in dev).
# If left empty or set to MOCK_BOT_TOKEN_FOR_DEV, the bot runs in mock mode.
TELEGRAM_BOT_TOKEN="MOCK_BOT_TOKEN_FOR_DEV"

# ── Node / Runtime Environment ──────────────────────────────────────────────
NODE_ENV="development"
